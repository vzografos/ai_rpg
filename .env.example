# LLM provider: any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama /v1, vLLM).
# Copy to .env and fill in. The provider layer is provider-agnostic (M0 decision,
# docs/roadmap.md): the documented default for PLAY is a strong API model; the
# in-container Ollama sibling is the local path (same code, different env).

# --- API (default for play) -------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Local (optional sibling service: `make up` with --profile ollama) -----
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b

# LLM_TIMEOUT=120
